---
/**
 * One hidden sprite per page, so `<use href="#fi-cad">` works from Astro templates and
 * from the map's client script alike, and every drawing lives in exactly one place.
 * Same 24-grid and 1.8 stroke as Icon.astro, so the sets sit together.
 *
 * fi-* are file types (data/file-types.ts); mi-* are the five reported metrics
 * (data/metrics.ts).
 */
---
<svg hidden aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
  <symbol id="fi-cad" viewBox="0 0 24 24"><path d="m12 3 8 4.5v9L12 21l-8-4.5v-9L12 3Z"/><path d="M4 7.5 12 12l8-4.5M12 12v9"/></symbol>
  <symbol id="fi-bom" viewBox="0 0 24 24"><path d="M10 6h10M10 12h10M10 18h10"/><path d="m4 6 1.2 1.2L7.5 5M4 12l1.2 1.2L7.5 11M4 18l1.2 1.2L7.5 17"/></symbol>
  <symbol id="fi-schematics" viewBox="0 0 24 24"><path d="M3 12h4l2-5 3 10 2-5h4"/><circle cx="20" cy="12" r="1.5"/></symbol>
  <symbol id="fi-pcb" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="16" rx="1.5"/><path d="M7 8h3v3H7zM14 13h3v3h-3zM10 9.5h5.5V13M8.5 11v5h5.5"/></symbol>
  <symbol id="fi-firmware" viewBox="0 0 24 24"><rect x="7" y="7" width="10" height="10" rx="1.5"/><path d="M10 3v4M14 3v4M10 17v4M14 17v4M3 10h4M3 14h4M17 10h4M17 14h4"/></symbol>
  <symbol id="fi-software" viewBox="0 0 24 24"><path d="m8 8-4 4 4 4M16 8l4 4-4 4M14 5l-4 14"/></symbol>
  <symbol id="fi-protocol" viewBox="0 0 24 24"><rect x="5" y="5" width="14" height="16" rx="1.5"/><path d="M9 3h6v3H9zM9 11h6M9 15h6M9 18.5h3"/></symbol>
  <symbol id="fi-documentation" viewBox="0 0 24 24"><path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H20v16H6.5A2.5 2.5 0 0 0 4 21V5.5Z"/><path d="M4 18.5A2.5 2.5 0 0 1 6.5 16H20M9 8h7"/></symbol>

  <symbol id="mi-motion-accuracy" viewBox="0 0 24 24"><circle cx="12" cy="12" r="6.5"/><path d="M12 2.5v4M12 17.5v4M2.5 12h4M17.5 12h4"/><circle cx="12" cy="12" r="1.2"/></symbol>
  <symbol id="mi-volumetric-accuracy" viewBox="0 0 24 24"><path d="M12 3s6.5 7 6.5 11.5a6.5 6.5 0 0 1-13 0C5.5 10 12 3 12 3Z"/></symbol>
  <symbol id="mi-cell-viability" viewBox="0 0 24 24"><circle cx="12" cy="12" r="8.5"/><circle cx="10.5" cy="11" r="3"/><path d="M16 15.5h.01M15 8.5h.01"/></symbol>
  <symbol id="mi-unattended-operation" viewBox="0 0 24 24"><circle cx="12" cy="12" r="8.5"/><path d="M12 7v5l3.5 2"/></symbol>
  <symbol id="mi-standard-compliance" viewBox="0 0 24 24"><path d="m12 3 7 3v6c0 4.2-3 7.4-7 9-4-1.6-7-4.8-7-9V6l7-3Z"/><path d="m9 12 2 2 4-4.5"/></symbol>
</svg>
