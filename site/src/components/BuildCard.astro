---
/**
 * One build, as a product card.
 *
 * The order is what a laboratory decides on, in the order it decides: what it costs,
 * what it is, the specs, then where the files are. Price leads because it eliminates most
 * candidates before anyone reads a title. There is no image -- none of the 60 sources
 * supplies one, and a placeholder would be decoration standing where information should be.
 *
 * A card states only what the paper states. 27 records give no cost, 47 no licence, 41 no
 * files; printing "not stated" for each of those made the absences the loudest thing on the
 * page while saying the least, and the facet sidebar already counts every one of them.
 *
 * A missing value is not printed, but it keeps its slot. Every card has the same rows in
 * the same places -- price with area and year, name, title, then Build / skill and Reports on the
 * same baseline, then files -- so a row of cards reads as a table would: the eye finds the
 * price where the price goes, and finds it empty. Cards that shifted everything up when the
 * cost was absent put the scores on three different lines across three neighbours.
 *
 * Area and year share the top row with the price. They are metadata, and they belong with
 * the other metadata rather than between the title and the specs; on the 27 cards with no
 * cost they are also what keeps the top row from being blank.
 */
import FileIcon from "./FileIcon.astro";
import MetricIcons from "./MetricIcons.astro";
import { orderFileTypes } from "../data/file-types";

export interface BuildRow {
  slug: string;
  title: string;
  tool: string;
  year: number | null;
  area: string;
  cost: string;
  costParsed: { display: string; partial: boolean; currencyInferred: boolean };
  licence: string;
  licenceSource: string;
  hasRepo: boolean;
  repoUrl: string;
  repoName: string;
  textRepoLink: string;
  repoMaintenance: string;
  repoAge: string;
  buildScore: number | null;
  skillScore: number | null;
  assetTypes: string[];
  /** Publisher-hosted supplementary file holding the design files, when there is no repository. */
  supplementUrl?: string;
  reportedCount: number;
  reportedTotal: number;
  fullTextRead: boolean;
  metrics: { id: string; status: string; value?: string | null }[];
}

export interface Props {
  row: BuildRow;
}

const { row } = Astro.props;

/** The repository's state, as the link's label. A deposit has no commit history to age. */
const repoLabel = row.repoMaintenance === "unknown" ? "Deposit" : row.repoMaintenance;
const repoAge = row.repoMaintenance !== "unknown" ? row.repoAge : "";

const files = orderFileTypes(row.assetTypes);
---

<article class="panel build-card">
  <div class="build-top">
    {row.costParsed.display ? (
      <p class="build-price">
        <span class="build-price-value" title={row.cost}>{row.costParsed.display}</span>
        {row.costParsed.currencyInferred && (
          <abbr class="build-price-note" title="The source states no currency; shown as USD">?</abbr>
        )}
        {row.costParsed.partial && (
          <abbr class="build-price-note" title="Excludes the printer or robot this mounts on">
            + host
          </abbr>
        )}
      </p>
    ) : (
      <p class="build-price" aria-hidden="true"></p>
    )}
    <p class="build-meta" title="Application area · year published">
      <span class="build-area">{row.area}</span>
      {row.year && <span class="build-year"> · {row.year}</span>}
    </p>
  </div>

  {/* The paper's title is the link; the instrument's name, where the paper gives one, is a
      quiet label above it rather than the thing you click. */}
  <p class="build-tool" aria-hidden={row.tool ? undefined : "true"} title={row.tool ? "The name the paper gives the instrument" : undefined}>{row.tool}</p>
  <h3 class="build-title">
    <a href={`/papers/${row.slug}`}>{row.title}</a>
  </h3>

  <dl class="build-specs">
    <div>
      <dt><abbr title="Parts sourcing score / skill needed score, each out of 5; higher is easier">Build/skill</abbr></dt>
      <dd>{row.buildScore !== null || row.skillScore !== null
        ? <span title={`Parts sourcing ${row.buildScore ?? "not scored"} · skill needed ${row.skillScore ?? "not scored"}, each out of 5; higher is easier`}>{row.buildScore ?? "–"}<i>/</i>{row.skillScore ?? "–"}</span>
        : <span class="absent" title="Not scored on the rubric">–</span>}</dd>
    </div>
    <div class="build-reports">
      <dt><abbr title="Motion accuracy · volumetric accuracy · cell viability · unattended operation · standard compliance. Coloured where the paper states a number.">Reports</abbr></dt>
      <dd><MetricIcons metrics={row.metrics} fullTextRead={row.fullTextRead} /></dd>
    </div>
    {row.licence && (
      <div class="build-licence">
        <dt><abbr title="Licence on the design files, not on the article">Licence</abbr></dt>
        <dd><span title={`Licence on the design files, read from ${row.licenceSource}`}>{row.licence}</span></dd>
      </div>
    )}
  </dl>

  {files.length > 0 || row.hasRepo ? (
    <p class="build-files">
      {files.length > 0 && (
        <span class="file-icon-row" aria-label="Files included">
          {files.map((f) => <FileIcon type={f} />)}
        </span>
      )}
      {!row.hasRepo && row.supplementUrl && (
        <a class="build-repo build-repo--supplement" href={row.supplementUrl} target="_blank" rel="noreferrer" title="Design files ship as the article's supplementary information">
          Supplement<span aria-hidden="true"> ↗</span>
        </a>
      )}
      {row.hasRepo && (
        <a
          class={`build-repo build-repo--${row.repoMaintenance}`}
          href={row.repoUrl}
          target="_blank"
          rel="noreferrer"
          title={`Design-file repository, ${repoLabel.toLowerCase()}${repoAge ? `, last activity ${repoAge}` : ""}: ${row.repoName}`}
        >
          {repoLabel}{repoAge && <i> · {repoAge}</i>}<span aria-hidden="true"> ↗</span>
        </a>
      )}
    </p>
  ) : (
    <p class="build-files" aria-hidden="true"></p>
  )}
</article>

<style>
  /* Five rows for five children: top (price · area · year) · name · title · specs · files.
     The title's track is the flexible one and the title sits at its start, so whatever
     height a one- or two-line title does not use is absorbed there, and the specs and
     files rows of every card in a row land on the same lines. A template with more tracks
     than children shipped once: the specs slid into the spare `1fr` track and stretched to
     fill it, by a different amount on every card. */
  .build-card {
    display: grid;
    grid-template-rows: auto auto minmax(0, 1fr) auto auto;
    gap: var(--space-2);
    padding: var(--space-3);
    height: 100%;
  }

  .build-top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2);
    min-height: 1.35rem;
  }
  .build-price {
    margin: 0;
    min-width: 0;
    font-size: var(--text-md);
    line-height: 1.2;
    white-space: nowrap;
  }
  .build-price-value {
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }
  .build-price-note {
    margin-left: var(--space-1);
    color: var(--accent-2-ink);
    font-size: var(--text-2xs);
    text-decoration: none;
    white-space: nowrap;
  }


  .build-title { margin: 0; align-self: start; font-size: var(--text-sm); line-height: 1.3; }
  .build-title a {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .build-tool {
    margin: 0 0 calc(-1 * var(--space-1));
    min-height: 1.3em;
    color: var(--muted);
    font-size: var(--text-2xs);
    font-weight: 700;
    line-height: 1.3;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .build-meta {
    margin: 0;
    color: var(--muted);
    font-size: var(--text-2xs);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    text-align: right;
  }
  .build-year { font-variant-numeric: tabular-nums; }

  /* Build / skill and Reports always occupy the first two columns, so they line up across every
     card; the licence, present on 13 of 60, takes the third when it exists and leaves it
     empty otherwise -- at the edge, where an empty cell is a margin rather than a hole. The
     Reports column is sized for its five marks so it never wraps. */
  .build-specs {
    display: grid;
    grid-template-columns: max-content minmax(6.4rem, auto) minmax(0, 1fr);
    grid-auto-rows: 2.6rem;
    align-items: start;
    gap: var(--space-2);
    margin: 0;
    padding-top: var(--space-2);
    border-top: 1px solid var(--line);
    font-size: var(--text-2xs);
  }
  .build-specs > div { min-height: 0; overflow: hidden; }
  .build-specs dt { color: var(--muted); white-space: nowrap; }
  .build-specs dt abbr { text-decoration: none; }
  /* One line, always: a licence that wrapped made its specs row taller and pushed the
     files line below its neighbours'. */
  .build-specs dd { margin: 0; font-variant-numeric: tabular-nums; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .build-reports dd { overflow: visible; }
  .build-specs i { font-style: normal; color: var(--muted); }

  /* One line, never two: icons on the left keep their size, the repository link on the
     right gives way with an ellipsis. A files row that wrapped on a narrow card pushed its
     specs 24px above its neighbours'. */
  .build-files {
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    height: 1.25rem;
    margin: 0;
    overflow: hidden;
  }
  .build-files .file-icon-row { flex: none; }
  .build-repo {
    flex: 0 1 auto;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    font-size: var(--text-2xs);
    font-weight: 700;
    text-transform: capitalize;
    white-space: nowrap;
  }
  .build-repo i { font-style: normal; font-weight: 400; color: var(--muted); text-transform: none; }
  .build-repo--active { color: var(--status-success); }
  .build-repo--aging { color: var(--status-warning); }
  .build-repo--supplement { color: var(--muted); }
  .build-repo--stale,
  .build-repo--unknown { color: var(--muted); }
</style>
