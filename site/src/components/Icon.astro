---
export interface Props {
  name: "layers" | "info" | "sliders" | "grid" | "rows" | "file-text" | "link" | "database" | "plus";
  size?: string;
}

const { name, size = "1em" } = Astro.props;
---

<svg class="ui-icon" width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === "layers" && <><path d="m12 3 9 5-9 5-9-5 9-5Z"/><path d="m3 12 9 5 9-5"/><path d="m3 16 9 5 9-5"/></>}
  {name === "info" && <><circle cx="12" cy="12" r="9"/><path d="M12 10v6M12 7h.01"/></>}
  {name === "sliders" && <><path d="M4 6h16M4 12h16M4 18h16"/><circle cx="9" cy="6" r="1.7"/><circle cx="15" cy="12" r="1.7"/><circle cx="7" cy="18" r="1.7"/></>}
  {name === "grid" && <><rect x="4" y="4" width="6" height="6" rx="1"/><rect x="14" y="4" width="6" height="6" rx="1"/><rect x="4" y="14" width="6" height="6" rx="1"/><rect x="14" y="14" width="6" height="6" rx="1"/></>}
  {name === "rows" && <><path d="M9 6h11M9 12h11M9 18h11"/><rect x="4" y="4.5" width="2.5" height="2.5" rx=".5"/><rect x="4" y="10.5" width="2.5" height="2.5" rx=".5"/><rect x="4" y="16.5" width="2.5" height="2.5" rx=".5"/></>}
  {name === "file-text" && <><path d="M6 3h8l4 4v14H6Z"/><path d="M14 3v5h5M9 13h6M9 17h6"/></>}
  {name === "link" && <><path d="M10 13a5 5 0 0 0 7.1.1l2-2a5 5 0 0 0-7.1-7.1l-1.1 1.1"/><path d="M14 11a5 5 0 0 0-7.1-.1l-2 2A5 5 0 0 0 12 20l1.1-1.1"/></>}
  {name === "database" && <><ellipse cx="12" cy="5" rx="8" ry="3"/><path d="M4 5v6c0 1.7 3.6 3 8 3s8-1.3 8-3V5"/><path d="M4 11v6c0 1.7 3.6 3 8 3s8-1.3 8-3v-6"/></>}
  {name === "plus" && <path d="M12 5v14M5 12h14"/>}
</svg>
