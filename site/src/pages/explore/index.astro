---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SliceNote from "../../components/SliceNote.astro";
import Pagination from "../../components/Pagination.astro";
import Select from "../../components/Select.astro";
import { DOMAIN_GROUPS, getDomainGroups } from "../../data/domain-groups";
import { assets, papers, repos, stats, tools, topics } from "../../data/loaders";

const entries = [
  ...papers.map((paper) => ({
    kind: "papers",
    label: "Paper",
    title: paper.title,
    href: `/papers/${paper.slug}`,
    meta: [paper.year, paper.venue].filter(Boolean).join(" · "),
    summary: paper.summary || paper.whyItMatters || paper.inclusionFit,
    categories: paper.category,
    domains: getDomainGroups(paper.category),
    evidence: [paper.repo && "repository", paper.assetIds.length > 0 && "asset"].filter(Boolean),
    search: [
      paper.title,
      paper.doi,
      paper.venue,
      paper.publication?.abstract,
      ...(paper.publication?.authors || []).map((author) => author.name),
      ...(paper.publication?.openAlex?.topics || []),
      ...(paper.publication?.openAlex?.keywords || []),
      ...paper.category,
      ...paper.modality,
      ...paper.toolNames
    ].filter(Boolean).join(" ")
  })),
  ...tools.map((tool) => ({
    kind: "tools",
    label: "Tool",
    title: tool.name,
    href: `/tools/${tool.slug}`,
    meta: `${tool.paperCount} linked ${tool.paperCount === 1 ? "paper" : "papers"} · ${tool.documentationTier} documentation`,
    summary: tool.perspectiveSnippet || tool.description,
    categories: tool.categories,
    domains: getDomainGroups(tool.categories),
    evidence: [tool.repoCount > 0 && "repository", tool.assetIds.length > 0 && "asset"].filter(Boolean),
    search: [tool.name, ...tool.aliases, ...tool.categories, ...tool.modalities, ...tool.paperTitles].join(" ")
  })),
  ...topics.map((topic) => ({
    kind: "topics",
    label: "Topic",
    title: topic.name,
    href: `/topics/${topic.slug}`,
    meta: `${topic.paperCount} papers · ${topic.toolCount} tools`,
    summary: topic.modalities.join(" · "),
    categories: [topic.name],
    domains: getDomainGroups([topic.name]),
    evidence: [],
    search: [topic.name, ...topic.aliases, ...topic.modalities, ...topic.paperTitles].join(" ")
  })),
  ...assets.map((asset) => ({
    kind: "assets",
    label: "Asset",
    title: asset.name,
    href: `/assets/${asset.slug}`,
    meta: `${asset.format || asset.type} · ${asset.paperCount} papers`,
    summary: asset.evidence || asset.notes,
    categories: [],
    domains: [],
    evidence: ["asset"],
    search: [asset.name, asset.type, asset.format, asset.evidence].join(" ")
  })),
  ...repos.map((repo) => ({
    kind: "repos",
    label: "Repository",
    title: repo.name,
    href: `/repos/${repo.slug}`,
    meta: `${repo.host} · ${repo.paperCount} linked papers`,
    summary: repo.url,
    categories: repo.categories,
    domains: getDomainGroups(repo.categories),
    evidence: ["repository"],
    search: [repo.name, repo.host, repo.url, ...repo.categories, ...repo.paperTitles].join(" ")
  }))
];

const tabs = [
  { value: "all", label: "All", count: entries.length },
  { value: "papers", label: "Papers", count: papers.length },
  { value: "tools", label: "Tools", count: tools.length },
  { value: "topics", label: "Topics", count: topics.length },
  { value: "assets", label: "Assets", count: assets.length },
  { value: "repos", label: "Repositories", count: repos.length }
];
const domains = DOMAIN_GROUPS.map((group) => group.name);
---

<BaseLayout title="Search | DIY Biofabrication Atlas" description="Search papers, tools, topics, assets, and repositories.">
  <SliceNote what="records of every type" />
  <header class="research-header">
    <div>
      <p class="context-label">Corpus search</p>
      <h1>Search the evidence map</h1>
      <p class="muted">One query across papers, practical systems, build assets, repositories, and topics.</p>
    </div>
    <dl class="coverage-summary">
      <div><dt>Papers</dt><dd>{stats.paperCount}</dd></div>
      <div><dt>Curated papers</dt><dd>{stats.curatedPaperCount}</dd></div>
      <div><dt>Mapped tools</dt><dd>{stats.toolCount}</dd></div>
    </dl>
  </header>

  <section class="search-workspace" data-tabbed-explorer>
    <div class="record-tabs" role="tablist" aria-label="Record type">
      {tabs.map((tab) => (
        <button
          type="button"
          role="tab"
          id={`record-tab-${tab.value}`}
          data-record-tab={tab.value}
          aria-controls="atlas-results"
          aria-selected={tab.value === "all" ? "true" : "false"}
          tabindex={tab.value === "all" ? "0" : "-1"}
        >
          <span>{tab.label}</span><span class="tab-count">{tab.count}</span>
        </button>
      ))}
    </div>

    <div class="workspace-controls">
      <label class="control-field workspace-query">
        <span class="control-label">Search terms</span>
        <input id="atlas-query" type="search" placeholder="e.g. syringe pump, OpenFlexure, CAD, cell culture" autocomplete="off" />
      </label>
      <Select
        id="atlas-domain"
        label="Domain"
        options={[{ value: "", label: "All domains", selected: true }, ...domains.map((domain) => ({ value: domain, label: domain }))]}
      />
      <Select
        id="atlas-evidence"
        label="Evidence"
        options={[
          { value: "", label: "Any evidence", selected: true },
          { value: "repository", label: "Repository" },
          { value: "asset", label: "Build asset" }
        ]}
      />
    </div>

    <div class="result-toolbar">
      <span id="atlas-result-count" aria-live="polite">{entries.length} records</span>
      <button type="button" id="atlas-clear" class="text-action" hidden>Clear search</button>
    </div>

    <div class="research-table-wrap">
      <table class="research-results" id="atlas-results">
        <caption class="sr-only">Search results from the DIY Biofabrication Atlas</caption>
        <colgroup>
          <col class="result-type-column" />
          <col class="result-record-column" />
          <col class="result-signals-column" />
        </colgroup>
        <thead>
          <tr>
            <th scope="col">Type</th>
            <th scope="col">Record</th>
            <th scope="col">Evidence</th>
          </tr>
        </thead>
        <tbody>
          {entries.map((entry) => (
            <tr
              class="research-result"
              data-record-item
              data-kind={entry.kind}
              data-category={entry.categories.join("|")}
              data-domain={entry.domains.join("|")}
              data-evidence={entry.evidence.join("|")}
              data-search={entry.search.toLowerCase()}
            >
              <td class="result-type" data-label="Type"><span>{entry.label}</span></td>
              <td class="result-body" data-label="Record">
                <h2><a href={entry.href}>{entry.title}</a></h2>
                {entry.meta && <p class="result-meta">{entry.meta}</p>}
                {entry.summary && <p class="result-summary">{entry.summary}</p>}
              </td>
              <td class="result-signals" data-label="Evidence">
                <div>
                  {entry.categories.slice(0, 2).map((category) => <span>{category}</span>)}
                  {entry.evidence.slice(0, 2).map((signal) => <span>{signal}</span>)}
                </div>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <Pagination id="atlas-pagination" label="Corpus search results pagination" />
    <div class="empty-search" id="atlas-empty" hidden>
      <h2>No matching records</h2>
      <p>Broaden the domain or evidence filter, or try a shorter technical term.</p>
    </div>
  </section>

  <script>
    import { formatPagedCount, initPagination } from "../../scripts/pagination.mjs";

    const query = document.getElementById("atlas-query");
    const domain = document.getElementById("atlas-domain");
    const evidence = document.getElementById("atlas-evidence");
    const count = document.getElementById("atlas-result-count");
    const clear = document.getElementById("atlas-clear");
    const empty = document.getElementById("atlas-empty");
    const tabs = [...document.querySelectorAll("[data-record-tab]")];
    const items = [...document.querySelectorAll("[data-record-item]")];
    const pageSize = 24;
    let activeTab = "all";
    let filteredItems = items;

    const params = new URLSearchParams(window.location.search);
    if (query instanceof HTMLInputElement) query.value = params.get("q") || "";
    if (domain instanceof HTMLSelectElement) domain.value = params.get("domain") || "";
    if (evidence instanceof HTMLSelectElement) evidence.value = params.get("evidence") || "";
    activeTab = params.get("tab") || "all";

    const filterParams = (q, domainValue, evidenceValue) => {
      const next = new URLSearchParams();
      if (q) next.set("q", q);
      if (activeTab !== "all") next.set("tab", activeTab);
      if (domainValue) next.set("domain", domainValue);
      if (evidenceValue) next.set("evidence", evidenceValue);
      return next;
    };

    const paginator = initPagination({
      navId: "atlas-pagination",
      pageSize,
      pageParam: "page",
      getItems: () => filteredItems,
      onPageChange: ({ items: pageItems, totalItems, page }) => {
        const visible = new Set(pageItems);
        items.forEach((item) => item.toggleAttribute("hidden", !visible.has(item)));
        if (count) count.textContent = formatPagedCount({ visible: pageItems.length, total: totalItems, page, pageSize });
      },
      onNavigate: () => document.querySelector(".result-toolbar")?.scrollIntoView({ behavior: "smooth", block: "start" })
    });

    const apply = (reset = true) => {
      const q = query instanceof HTMLInputElement ? query.value.trim().toLowerCase() : "";
      const domainValue = domain instanceof HTMLSelectElement ? domain.value : "";
      const evidenceValue = evidence instanceof HTMLSelectElement ? evidence.value : "";
      const matches = items.filter((item) => {
        const kindMatch = activeTab === "all" || item.getAttribute("data-kind") === activeTab;
        const queryMatch = !q || (item.getAttribute("data-search") || "").includes(q);
        const domainMatch = !domainValue || (item.getAttribute("data-domain") || "").split("|").includes(domainValue);
        const evidenceMatch = !evidenceValue || (item.getAttribute("data-evidence") || "").split("|").includes(evidenceValue);
        return kindMatch && queryMatch && domainMatch && evidenceMatch;
      });
      filteredItems = matches;
      tabs.forEach((tab) => {
        const selected = tab.getAttribute("data-record-tab") === activeTab;
        tab.setAttribute("aria-selected", selected ? "true" : "false");
        tab.setAttribute("tabindex", selected ? "0" : "-1");
      });
      if (empty) empty.toggleAttribute("hidden", matches.length > 0);
      if (clear) clear.toggleAttribute("hidden", !(q || domainValue || evidenceValue || activeTab !== "all"));
      const next = filterParams(q, domainValue, evidenceValue);
      if (reset) paginator?.reset(next);
      else paginator?.refresh(next);
    };

    tabs.forEach((tab) => tab.addEventListener("click", () => { activeTab = tab.getAttribute("data-record-tab") || "all"; apply(); }));
    tabs.forEach((tab, index) => tab.addEventListener("keydown", (event) => {
      if (!(event instanceof KeyboardEvent)) return;
      let nextIndex = index;
      if (event.key === "ArrowRight") nextIndex = (index + 1) % tabs.length;
      else if (event.key === "ArrowLeft") nextIndex = (index - 1 + tabs.length) % tabs.length;
      else if (event.key === "Home") nextIndex = 0;
      else if (event.key === "End") nextIndex = tabs.length - 1;
      else return;
      event.preventDefault();
      const nextTab = tabs[nextIndex];
      activeTab = nextTab.getAttribute("data-record-tab") || "all";
      apply();
      if (nextTab instanceof HTMLElement) nextTab.focus();
    }));
    query?.addEventListener("input", () => apply());
    domain?.addEventListener("change", () => apply());
    evidence?.addEventListener("change", () => apply());
    clear?.addEventListener("click", () => {
      if (query instanceof HTMLInputElement) query.value = "";
      if (domain instanceof HTMLSelectElement) domain.value = "";
      if (evidence instanceof HTMLSelectElement) evidence.value = "";
      activeTab = "all";
      domain?.dispatchEvent(new Event("change", { bubbles: true }));
      evidence?.dispatchEvent(new Event("change", { bubbles: true }));
    });
    apply(false);
  </script>
</BaseLayout>

<style>
  .research-header {
    display: flex;
    justify-content: space-between;
    gap: var(--space-8);
    padding: var(--space-4) 0 var(--space-5);
    border-bottom: 1px solid var(--line-strong);
  }

  .context-label {
    margin: 0 0 var(--space-1);
    color: var(--accent);
    font-size: var(--text-xs);
    font-weight: 700;
  }

  .research-header h1 { margin: 0; font-size: var(--text-2xl); }
  .research-header p:last-child { max-width: 68ch; margin: var(--space-2) 0 0; }

  .coverage-summary {
    display: grid;
    grid-template-columns: repeat(3, minmax(5rem, 1fr));
    margin: 0;
    min-width: 19rem;
  }

  .coverage-summary div { padding: var(--space-2) var(--space-3); border-left: 1px solid var(--line); }
  .coverage-summary dt { color: var(--muted); font-size: var(--text-2xs); }
  .coverage-summary dd { margin: var(--space-1) 0 0; font-size: var(--text-lg); font-weight: 700; }

  .search-workspace { margin-top: 0; }
  .workspace-controls { display: grid; grid-template-columns: minmax(18rem, 2fr) repeat(2, minmax(11rem, 1fr)); gap: var(--space-3); padding: var(--space-4) 0; border-bottom: 1px solid var(--line); }
  .record-tabs { display: flex; overflow-x: auto; border-bottom: 1px solid var(--line-strong); scrollbar-width: thin; }
  .record-tabs button { display: flex; align-items: center; gap: var(--space-2); min-height: var(--control-height); padding: 0 var(--space-3); border: 0; border-bottom: 2px solid transparent; background: transparent; color: var(--muted); font: inherit; font-weight: 700; white-space: nowrap; cursor: pointer; }
  .record-tabs button:hover { text-decoration: underline; }
  .record-tabs button[aria-selected="true"] { color: var(--accent); border-bottom-color: var(--accent); }
  .tab-count { font-variant-numeric: tabular-nums; font-size: var(--text-2xs); }
  .result-toolbar { display: flex; justify-content: space-between; align-items: center; min-height: var(--control-height); color: var(--muted); font-size: var(--text-xs); }
  .text-action { border: 0; background: transparent; color: var(--accent); font: inherit; font-weight: 700; cursor: pointer; }

  .research-table-wrap { min-width: 0; }
  .research-results { width: 100%; border-collapse: collapse; table-layout: fixed; border-top: 1px solid var(--line-strong); }
  .result-type-column { width: 7.5rem; }
  .result-signals-column { width: 19rem; }
  .research-results th { padding: var(--space-2) var(--space-3); border-bottom: 1px solid var(--line-strong); background: var(--surface-alt); color: var(--muted); font-size: var(--text-2xs); font-weight: 700; text-align: left; }
  .research-results th:last-child { text-align: right; }
  .research-result { border-bottom: 1px solid var(--line); }
  .research-result[hidden] { display: none; }
  .research-result td { padding: var(--space-3); vertical-align: top; }
  .result-type { color: var(--muted); font-size: var(--text-2xs); font-weight: 700; }
  .result-type span { display: inline-flex; min-height: 1.5rem; align-items: center; padding: 0 var(--space-2); border: 1px solid var(--line); background: var(--surface); }
  .result-body h2 { margin: 0; font-size: var(--text-sm); line-height: 1.3; }
  .result-body h2 a { text-decoration: none; }
  .result-body h2 a:hover, .result-body h2 a:focus-visible { text-decoration: underline; }
  .result-meta, .result-summary { margin: var(--space-1) 0 0; font-size: var(--text-2xs); }
  .result-meta { color: var(--muted); }
  .result-summary { max-width: 75ch; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .result-signals > div { display: flex; align-content: flex-start; justify-content: flex-end; flex-wrap: wrap; gap: var(--space-1); }
  .result-signals span { padding: 0.15rem var(--space-2); border: 1px solid var(--line); color: var(--muted); font-size: var(--text-2xs); }
  .empty-search { padding: var(--space-10) 0; text-align: center; }
  .empty-search h2 { margin: 0; font-size: var(--text-lg); }
  .empty-search p { color: var(--muted); }

  @media (max-width: 900px) {
    .research-header { display: block; }
    .coverage-summary { margin-top: var(--space-4); min-width: 0; }
    .coverage-summary div:first-child { border-left: 0; padding-left: 0; }
    .workspace-controls { grid-template-columns: 1fr; }
    .research-results, .research-results tbody { display: block; }
    .research-results colgroup, .research-results thead { display: none; }
    .research-result { display: grid; grid-template-columns: minmax(0, 1fr); padding: var(--space-3) 0; }
    .research-result td { display: block; padding: 0; }
    .result-type { margin-bottom: var(--space-2); }
    .result-signals > div { justify-content: flex-start; margin-top: var(--space-2); }
  }
</style>
